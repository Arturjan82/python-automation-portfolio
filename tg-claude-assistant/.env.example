# Скопируйте этот файл в .env и впишите свои значения. Файл .env в git не попадает.
TELEGRAM_TOKEN=токен_от_BotFather
ANTHROPIC_API_KEY=ключ_из_консоли_Anthropic
# Telegram ID тех, кому разрешено писать боту (через запятую). Свой ID покажет команда /id
ALLOWED_USER_IDS=
# Необязательно:
# CLAUDE_MODEL=claude-sonnet-5-5
# MAX_HISTORY=20
# SYSTEM_PROMPT=Ты помощник, отвечай коротко.
